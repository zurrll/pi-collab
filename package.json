{
  "name": "pi-collab",
  "version": "0.1.0",
  "description": "Multi-agent collaboration extension for pi — enables multiple pi instances to communicate and collaborate on shared tasks",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "collaboration", "multi-agent"],
  "author": "zurrll",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zurrll/pi-collab.git"
  },
